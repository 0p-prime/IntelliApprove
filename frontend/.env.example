# IntelliApprove Frontend Environment Variables
# Leave blank or omit in local dev if using Vite's built-in proxy (/api -> http://127.0.0.1:8000)
# In production (e.g. Vercel, Netlify), set this to your deployed backend URL.

# Example Render backend URL:
VITE_API_URL=https://intelliapprove-backend.onrender.com

# Example Railway backend URL:
# VITE_API_URL=https://intelliapprove-production.up.railway.app

