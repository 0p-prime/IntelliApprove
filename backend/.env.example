# IntelliApprove Backend Environment Variables
PROJECT_NAME="IntelliApprove AICTE Approval Platform"
PROJECT_VERSION="1.0.0"

# Security (Replace with a strong random 256-bit key in production)
SECRET_KEY="aicte_sih_2026_super_secret_jwt_key_98374283749234"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# 1. Local Development (SQLite):
# DATABASE_URL="sqlite:///./intelliapprove.db"

# 2. Managed PostgreSQL on Supabase:
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require"

# 3. Managed PostgreSQL on Neon:
# DATABASE_URL="postgresql://[USER]:[PASSWORD]@[ENDPOINT].neon.tech/neondb?sslmode=require"

# 4. Managed PostgreSQL on Render:
# DATABASE_URL="postgresql://intelliapprove_user:[PASSWORD]@[HOST].render.com/intelliapprove?sslmode=require"

# CORS Configuration (Comma-separated or JSON list of allowed origins)
# In production, set to your frontend domain (e.g. https://intelliapprove.vercel.app)
BACKEND_CORS_ORIGINS=["https://intelliapprove.vercel.app","https://intelliapprove.netlify.app","http://localhost:5173","http://127.0.0.1:5173"]

# Background Scheduler & SLA Monitoring
ENABLE_SCHEDULER=true
SLA_CHECK_INTERVAL_SECONDS=30
ALERT_EVAL_INTERVAL_SECONDS=60

# Notification Gateways (Optional: Mailtrap or Production SMTP)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="alerts@aicte.gov.in"
ENABLE_EXTERNAL_CHANNELS=true

# AI Statutory Assistant (Optional LLM Key - Gemini / OpenAI; falls back gracefully to keyword intent parsing)
GEMINI_API_KEY=""

